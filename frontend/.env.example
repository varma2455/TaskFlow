# =============================================================================
# TaskFlow Pro — Frontend Environment Configuration Template
# =============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to `frontend/.env.local` (the Next.js application root).
# 2. Populate the required values from your Supabase and Google Cloud dashboards.
# 3. RESTART your Next.js development server after changing environment variables:
#    cd frontend && npm run dev
#
# SECURITY NOTICE:
# - `frontend/.env.local` is gitignored. NEVER commit real credentials to Git.
# - NEVER put `SUPABASE_SERVICE_ROLE_KEY` or Google Client Secrets in this file!
#   Those belong strictly in the server environment (`backend/.env` on Render).
# =============================================================================

# 1. Supabase Project Configuration (REQUIRED for Live Auth & Realtime)
# Obtain from: Supabase Dashboard -> Project Settings -> API
# Format: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Supabase Public Publishable Key (REQUIRED)
# Obtain from: Supabase Dashboard -> Project Settings -> API -> Project API keys -> "publishable key" or "anon public"
# Supports either modern publishable key (sb_publishable_...) or standard anon JWT
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-supabase-publishable-key
# (NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted as an alias for backwards compatibility)

# 3. Backend Flask REST API Gateway Base URL (REQUIRED)
# In local development: http://localhost:5000/api
# In production on Vercel: Set to your deployed Render URL (e.g. https://taskflow-api.onrender.com/api)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# 4. Frontend Application Origin
# In local development: http://localhost:3000
# In production on Vercel: https://your-production-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

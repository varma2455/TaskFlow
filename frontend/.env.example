# =============================================================================
# TaskFlow Frontend Environment Configuration (.env.example)
# Location in production: Vercel Project Settings -> Environment Variables
# =============================================================================

# Public Supabase URL & Anon/Publishable Key
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Flask Backend API Gateway Base URL
# In local development: http://localhost:5000/api
# In production on Vercel: Set to your deployed Render backend URL (e.g., https://taskflow-backend.onrender.com/api)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Frontend Application Origin
NEXT_PUBLIC_APP_URL=http://localhost:3000

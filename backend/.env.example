# =============================================================================
# TaskFlow Backend Environment Configuration (.env.example)
# Location in production: Render Environment Variables
# =============================================================================

# Flask Application Settings
FLASK_ENV=production
DEBUG=False
PORT=5000
SECRET_KEY=replace-with-a-secure-random-32-char-string

# Allowed Frontend Origins for CORS (Comma-separated)
# In production on Render, set this to your deployed Vercel frontend URL
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-taskflow-frontend.vercel.app
APP_URL=http://localhost:3000

# Supabase PostgreSQL Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder
# Backend requires Service Role Key to manage durable email outbox and system background tasks
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder
# Supabase JWT Secret for server-side token signature verification
# Found in: Supabase Dashboard -> Project Settings -> API -> JWT Settings
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder

# Google OAuth & Gmail API (Production Email Notifications)
# Found in: Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GMAIL_SENDER_EMAIL=notifications@yourdomain.com
GMAIL_REFRESH_TOKEN=your-gmail-oauth-refresh-token-placeholder

# Deadline Reminders & Worker Configuration
REMINDER_WINDOW_HOURS=24
MAX_EMAIL_RETRIES=3
CRON_SECRET=your-internal-secret-for-scheduled-worker-endpoints
USE_MOCK_DB=False

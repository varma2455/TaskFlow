# =============================================================================
# TaskFlow Pro — Backend Environment Configuration Template
# =============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to `backend/.env` (the Flask application root).
# 2. In production on Render: Set these variables in the Render Dashboard Environment tab.
# 3. RESTART your Flask development server after changing environment variables:
#    PYTHONPATH=. backend/venv/bin/python backend/app.py
#
# SECURITY NOTICE:
# - `backend/.env` contains privileged server-side credentials and is gitignored.
# - NEVER share or commit `SUPABASE_SERVICE_ROLE_KEY` or `GOOGLE_CLIENT_SECRET`.
# =============================================================================

# Flask Environment & Port
FLASK_ENV=production
DEBUG=False
PORT=5000
SECRET_KEY=replace-with-a-secure-random-32-char-string

# Allowed Frontend Origins for CORS (Comma-separated)
# In production on Render, add your deployed Vercel domain
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-taskflow-frontend.vercel.app
APP_URL=http://localhost:3000

# Supabase Server-Side Configuration (REQUIRED for Live PostgreSQL)
# Obtain from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Privileged Service Role Key (Used for durable outbox and backend admin queries)
# Obtain from: Supabase Dashboard -> Project Settings -> API -> Project API keys -> "service_role secret"
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder

# Supabase JWT Secret for cryptographic signature verification (HS256)
# Obtain from: Supabase Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1

# Direct Supabase PostgreSQL Connection URI (Optional for direct connection pooling & scripts/apply_migrations.py)
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DB_POOL_MIN=1
DB_POOL_MAX=10

# Google OAuth & Gmail API (Production Email Notifications)
# Obtain from: Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GMAIL_SENDER_EMAIL=notifications@yourdomain.com
GMAIL_REFRESH_TOKEN=your-gmail-oauth-refresh-token-placeholder

# Deadline Reminders & Worker Configuration
REMINDER_WINDOW_HOURS=24
MAX_EMAIL_RETRIES=3
CRON_SECRET=your-internal-secret-for-scheduled-worker-endpoints
USE_MOCK_DB=False
